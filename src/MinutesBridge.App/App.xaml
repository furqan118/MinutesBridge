<Application x:Class="MinutesBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Navy" Color="#0D2850" />
    <SolidColorBrush x:Key="Indigo" Color="#3E51E8" />
    <SolidColorBrush x:Key="Teal" Color="#08AFA3" />
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,4,0,12" />
      <Setter Property="BorderBrush" Value="#CED6E2" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
