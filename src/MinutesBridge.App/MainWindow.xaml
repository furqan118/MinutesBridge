<Window x:Class="MinutesBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinutesBridge" Height="850" Width="1360" MinHeight="720" MinWidth="1100"
        Background="#F4F7FB" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition/><RowDefinition Height="72"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EE" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MinutesBridge" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="24" />
          <TextBlock Text="Teams notes → Confluence" Foreground="#60708A" FontSize="13" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFF4D8" CornerRadius="16" Padding="12,6">
          <TextBlock Text="Draft • Review required" Foreground="#855400" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="560"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#DDE4EE" BorderThickness="1" CornerRadius="10" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="#EEF2FF" BorderBrush="#CBD3FF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Confluence connection" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="#60708A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect" Click="Connect_Click"
                          Background="White" BorderBrush="{StaticResource Indigo}" Foreground="{StaticResource Indigo}" Margin="12,0,0,0"/>
                </DockPanel>
                <TextBlock Text="Space" Margin="0,10,0,0"/>
                <ComboBox x:Name="SpaceInput" Margin="0,4,0,8" Padding="8" IsEnabled="False"
                          SelectionChanged="SpaceInput_SelectionChanged"/>
                <TextBlock Text="Parent page"/>
                <ComboBox x:Name="ParentPageInput" Margin="0,4,0,0" Padding="8" IsEnabled="False"/>
                <TextBlock x:Name="PreviousMinutesStatus" Text="Previous BHITS page: not loaded"
                           Foreground="#60708A" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock Text="1  Import &amp; describe" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Navy}" Margin="0,0,0,14"/>
            <DockPanel LastChildFill="False">
              <TextBlock Text="Paste Facilitator notes" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Paste rich clipboard" Click="PasteClipboard_Click"
                      Padding="10,5" Margin="8,0,0,4" ToolTip="Imports bounded RTF or Unicode text from the local clipboard."/>
            </DockPanel>
            <TextBox x:Name="NotesInput" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="ACE version control:&#x0a;- Confirm the shared release process.&#x0a;&#x0a;Staff events:&#x0a;- Confirm attendance and timing." />
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
              <TextBlock Text="Editable agenda" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Rebuild from notes" Click="BuildAgenda_Click" Padding="10,5" Margin="8,0,0,0"/>
            </DockPanel>
            <DataGrid x:Name="AgendaGrid" Height="230" Margin="0,0,0,6" ItemsSource="{Binding}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" RowHeight="76" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Topic" Width="11*" Binding="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Name" Width="8*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="Notes (one per line)" Width="20*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="2" Padding="5"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel LastChildFill="False" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Add" Click="AddAgenda_Click" Padding="10,5" Margin="0,0,4,0"/>
                <Button Content="Remove" Click="RemoveAgenda_Click" Padding="10,5" Margin="0,0,4,0"/>
                <Button Content="↑" Click="MoveAgendaUp_Click" Padding="10,5" Margin="0,0,4,0" ToolTip="Move selected row up"/>
                <Button Content="↓" Click="MoveAgendaDown_Click" Padding="10,5" Margin="0" ToolTip="Move selected row down"/>
              </StackPanel>
              <TextBlock x:Name="AgendaStatus" DockPanel.Dock="Right" Foreground="#60708A" FontSize="12"
                         VerticalAlignment="Center" Text="Agenda not built"/>
            </DockPanel>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0"><TextBlock Text="Meeting group"/><TextBox x:Name="GroupInput" Text="BHITS"/></StackPanel>
              <StackPanel Margin="6,0,0,0"><TextBlock Text="Date"/><DatePicker x:Name="DateInput" Margin="0,4,0,12" Padding="6" SelectedDateChanged="DateInput_SelectedDateChanged"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="Time"/><TextBox x:Name="TimeInput" Text="10:00 AM – 11:30 AM"/>
            <TextBlock Text="Facilitator"/><TextBox x:Name="FacilitatorInput"/>
            <TextBlock Text="Note taker"/><TextBox x:Name="NoteTakerInput"/>
            <TextBlock Text="Attendees (one per line)"/><TextBox x:Name="AttendeesInput" Height="72" AcceptsReturn="True"/>
            <TextBlock Text="Regrets (one per line)"/><TextBox x:Name="RegretsInput" Height="60" AcceptsReturn="True"/>
            <Button Content="Generate Confluence preview" Click="GeneratePreview_Click" Background="{StaticResource Indigo}" Foreground="White" BorderThickness="0" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="#DDE4EE" BorderThickness="1" CornerRadius="10" Padding="26">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="2  Review page" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Navy}"/>
            <TextBlock Text="Nothing is published until you confirm." Foreground="#60708A" Margin="0,4,0,18"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="TitlePreview" Text="Meeting page preview" FontWeight="Bold" FontSize="26" Foreground="{StaticResource Navy}" Margin="0,0,0,18"/>
              <TextBox x:Name="PreviewOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                       FontFamily="Segoe UI" FontSize="15" Background="Transparent" MinHeight="500"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#DDE4EE" BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <TextBlock Text="ⓘ Review sensitive information before publishing." VerticalAlignment="Center" Foreground="#60708A"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Save local draft" Click="SaveDraft_Click" Background="White" BorderBrush="{StaticResource Indigo}" Foreground="{StaticResource Indigo}"/>
          <Button Content="Publish to Confluence" Click="Publish_Click" Background="{StaticResource Indigo}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
